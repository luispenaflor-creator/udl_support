# ---- Públicas (se envían al navegador) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos que aun usan la clave anon antigua (opcional)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Solo servidor (NUNCA con prefijo NEXT_PUBLIC_) ----
# Alta de usuarios, destinatarios de correo y bitácora de envíos.
SUPABASE_SERVICE_ROLE_KEY=

# Correo saliente (SMTP). Sin estas variables no se envía ningún correo. Ver docs/CORREO.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UDL Support <mesadeayuda@udlondres.com>"
MAIL_REPLY_TO=

# ---- Pendientes (Gmail entrante y push) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_PUBSUB_TOPIC=
GMAIL_POLL_SECRET=replace-with-random-secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mesadeayuda@udlondres.com
